---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site.config';
---
<Layout title={`Mentions Légales | ${siteConfig.name}`}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-8 sm:p-12 text-slate-300 text-sm leading-relaxed">
      <h1 class="text-2xl sm:text-4xl font-black text-white mb-6">Mentions Légales</h1>
      <p class="mb-4"><strong class="text-white">Éditeur du site :</strong> {siteConfig.legal.editor}, {siteConfig.legal.address}. Contact : {siteConfig.legal.contactEmail}.</p>
      <p class="mb-4"><strong class="text-white">Hébergement :</strong> {siteConfig.legal.hostName}, {siteConfig.legal.hostAddress}.</p>
      <p><strong class="text-white">Propriété intellectuelle :</strong> L'ensemble des contenus de ce site relève de la législation française et internationale sur le droit d'auteur et la propriété intellectuelle.</p>
    </div>
  </div>
</Layout>