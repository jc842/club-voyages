---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allBlog = await getCollection('blog', ({ data }) => data.lang === 'en');
  const allPages = await getCollection('pages', ({ data }) => data.lang === 'en');

  const blogPaths = allBlog.map(post => ({
    params: { slug: post.id },
    props: { entry: post, isBlog: true },
  }));

  const pagesPaths = allPages.map(page => ({
    params: { slug: page.id },
    props: { entry: page, isBlog: false },
  }));

  return [...blogPaths, ...pagesPaths];
}

const { entry, isBlog } = Astro.props;
const { Content } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.heroImage}
  article={isBlog}
  lang="en"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <article class="bg-slate-900/70 border border-slate-800/80 backdrop-blur-md p-6 sm:p-12 rounded-3xl shadow-2xl">
      <header class="mb-10 pb-8 border-b border-slate-800">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-950/80 border border-indigo-500/30 text-indigo-300 mb-4">
          <span>{entry.data.category || 'Travel Guide'}</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-4">
          {entry.data.title}
        </h1>
        {entry.data.pubDate && (
          <div class="text-xs text-slate-400">
            <span>Published on {new Date(entry.data.pubDate).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          </div>
        )}
      </header>

      {entry.data.heroImage && (
        <div class="mb-10 rounded-2xl overflow-hidden shadow-2xl border border-slate-800 max-w-3xl mx-auto">
          <img src={entry.data.heroImage} alt={entry.data.title} class="w-full h-auto object-cover max-h-[480px]" loading="eager" />
        </div>
      )}

      <div class="prose prose-invert prose-indigo max-w-none prose-headings:text-white prose-p:text-slate-300 prose-li:text-slate-300 prose-strong:text-white leading-relaxed">
        <Content />
      </div>
    </article>
  </div>
</Layout>
