---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site.config';

const esPosts = await getCollection('blog', ({ data }) => data.lang === 'es' && !data.draft);
esPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title={`${siteConfig.name} — Guías de Viaje Exclusivas y Grandes Escapadas`} lang="es">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <header class="mb-14 text-center sm:text-left border-b border-slate-800 pb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-950/80 border border-indigo-500/30 text-indigo-300 mb-4">
        <span>Guías VIP de Destinos</span>
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
        <span>Edición en Español</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
        Grandes Escapadas y Capitales Mundiales
      </h1>
      <p class="text-slate-400 max-w-2xl text-base sm:text-lg">
        Itinerarios de 3 a 14 días seleccionados, villas de ensueño en el Caribe Francés y las mejores guías para viajar con estilo.
      </p>
    </header>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {esPosts.map(post => (
        <article class="group bg-slate-900/60 rounded-2xl border border-slate-800/80 hover:border-indigo-500/50 overflow-hidden transition-all duration-300 hover:shadow-xl hover:shadow-indigo-500/10 flex flex-col">
          {post.data.heroImage && (
            <a href={`/es/${post.id}/`} class="aspect-[16/10] overflow-hidden bg-slate-800 block relative">
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
              <span class="absolute top-3 left-3 text-[11px] font-bold uppercase tracking-wider text-indigo-300 bg-slate-950/80 backdrop-blur-md px-2.5 py-1 rounded-md border border-indigo-500/30">
                {post.data.category}
              </span>
            </a>
          )}
          <div class="p-6 flex flex-col flex-grow">
            <h2 class="text-lg font-bold text-white group-hover:text-indigo-400 transition-colors line-clamp-2 mb-3">
              <a href={`/es/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 mb-6 flex-grow leading-relaxed">
              {post.data.description}
            </p>
            <div class="flex items-center justify-between pt-4 border-t border-slate-800/60 text-xs text-slate-500">
              <span>{new Date(post.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
              <a href={`/es/${post.id}/`} class="inline-flex items-center text-indigo-400 font-semibold group-hover:translate-x-1 transition-transform">
                Leer guía &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
